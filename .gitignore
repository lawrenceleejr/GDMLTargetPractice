# Build directories
build/
Build/
BUILD/
build-*/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake
!CMakeLists.txt

# Compiled binaries / objects
# NOTE: do NOT add a bare "g4sim" pattern here — it would shadow the g4sim/
# source directory. The built executable lives under build/ (already ignored).
neutrino
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# Geant4 data/source directories (downloaded inside container)
geant4-data/
geant4-source/
geant4-build/
geant4-install/

# Geant4 / ROOT output files
*.root
*.rndm
*.wrl
*.heprep
*.prim
G4*.dat

# Log files
*.log
*.err

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
\#*\#
.#*
*.user
*.suo
*.vcxproj
*.vcxproj.filters
*.sln
.directory

# Temporary / backup files
*.tmp
*.bak
*.orig
Dockerfile.bak

# Documentation
doc/html/
doc/latex/
*.pdf
!docs/*.pdf

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
venv/
env/

# macOS / Windows metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Archive files
*.tar
*.tar.gz
*.zip
*.7z

# Core dumps
core
core.*

# gdmltp run artifacts. `gdmltp run` defaults -o to the current directory, so
# running it from a checkout drops these next to the sources -- which is how
# run/run.mac and run/MAIA_260211.gdml ended up tracked in this repo. Patterns
# are the exact generated names (never a bare *.mac / *.gdml, which would
# shadow macros/ and gdml/).
gdmltp_run.mac
gdmltp_transport.mac
gdmltp_transport.json
gdmltp_display/
beam.dat
events.hepmc
scene.json
*_job.json
# the display copies the builder next to its output; keep the packaged source
build_blend.py
!gdmltp/assets/build_blend.py
# staged geometry copies land in the run dir; real geometries live in gdml/
/*.gdml

# GENIE Externals
splines/
genie/externals/
